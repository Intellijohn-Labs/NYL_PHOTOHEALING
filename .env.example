# Copy these into Vercel -> Project -> Settings -> Environment Variables (or a .env.local file on a server).
# Never commit real values to Git.

# Supabase project (Project Settings -> API). When NYL moves to the company server, change these two.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-key-here

# Private bucket where the WhatsApp bot stores the photos
PHOTO_BUCKET=nyl-photos

# Long random text used to sign the login cookie (at least 32 characters). Changing it logs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# Healer logins. Add or change people here; no code change needed.
HEALER_USERS=[{"username":"nisar","name":"Nisar","password":"change-me-1"},{"username":"sahala","name":"Sahala","password":"change-me-2"}]
